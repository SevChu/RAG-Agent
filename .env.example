APP_NAME=Agentic
# product: normal agent workflows; research: opt-in benchmark tooling (research source only)
AGENTIC_EDITION=product
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_AVAILABLE_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Reserved OpenAI-compatible providers. Fill both API_KEY and MODELS to enable one.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODELS=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODELS=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODELS=
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TEMPERATURE=0.2
RAG_ANSWER_TOP_K=6
RAG_ANSWER_CANDIDATE_K=20
RAG_SUMMARY_TOP_K=12
RAG_SUMMARY_CANDIDATE_K=40
RAG_SUMMARY_MAX_SOURCES=10
RAG_SUMMARY_CONTEXT_MAX_CHARS=8000
RAG_EXAM_TOP_K=12
RAG_EXAM_CANDIDATE_K=40
RAG_EXAM_MAX_SOURCES=10
RAG_EXAM_CONTEXT_MAX_CHARS=8000
RAG_MIN_SIMILARITY_SCORE=0.3
RAG_CONTEXT_MAX_MESSAGES=6
RAG_CONTEXT_MAX_CHARS=6000
QUICK_CHAT_CONTEXT_MAX_MESSAGES=10
QUICK_CHAT_CONTEXT_MAX_CHARS=8000
EXTERNAL_SEARCH_ENABLED=true
# Optional DeepSeek model dedicated to server-side Web Search; blank uses the first DeepSeek model.
EXTERNAL_SEARCH_MODEL=
EXTERNAL_SEARCH_TIMEOUT_SECONDS=60
EXTERNAL_SEARCH_MAX_USES=1
EXTERNAL_SEARCH_MAX_RESULTS=6
EXTERNAL_SEARCH_TRIGGER_SCORE=0.55

DATABASE_URL=sqlite+aiosqlite:///../data/app.db
QDRANT_PATH=../data/qdrant
QDRANT_COLLECTION_NAME=knowledge_chunks_v1
UPLOAD_DIR=../data/uploads
PADDLE_OCR_BASE_DIR=../data/models/paddleocr
EMBEDDING_MODEL_PATH=../data/models/embedding/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
RERANKER_MODEL_PATH=../data/models/reranker/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
AUTO_INDEX_DOCUMENTS=true
MAX_UPLOAD_MB=100
